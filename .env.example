# ==============================================================================
# Project Doctor - Environment Configuration Template
# Copy this file to .env and populate with your environment-specific values.
# NEVER commit .env to version control.
# ==============================================================================

# Application Settings
PROJECT_NAME="Project Doctor"
VERSION="1.0.0"
ENVIRONMENT="development"    # Options: development, staging, production
DEBUG=True                  # Set to False in production
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# Local SQLite (default for development):
DATABASE_URL="sqlite:///./project_doctor.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/project_doctor"

# Security & JWT Authentication
# Generate a cryptographically secure key with: openssl rand -hex 32
SECRET_KEY="change-me-to-a-secure-random-secret-key-at-least-32-chars-long"
JWT_SECRET=""               # Optional alias for SECRET_KEY
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours

# Google Gemini AI Integration (Optional)
# Deterministic static analyzers (Quality, Security, Dependencies, Architecture, Health)
# operate 100% locally and offline without an AI key.
# A valid Gemini API key is required ONLY for Stage 10 (AI Explainer) and Stage 11 (Ask My Codebase).
GEMINI_API_KEY=""           # Obtain from https://aistudio.google.com/
GEMINI_MODEL="gemini-2.5-flash"

# Storage & Upload Limits
MAX_UPLOAD_SIZE_MB=50
# Path where uploaded ZIP archives and cloned repositories are sandboxed
STORAGE_DIR="./storage"
PROJECT_STORAGE_PATH=""     # Optional alias for STORAGE_DIR

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Frontend Configuration (for frontend production build)
VITE_API_URL="/api"
